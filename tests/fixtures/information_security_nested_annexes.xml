      <w:pPr><w:pStyle w:val="Normal"/></w:pPr>
      <w:r><w:t>This fixture stands in for the cover regulation text of the implementing act.</w:t></w:r>
    </w:p>
    <w:p>
      <w:pPr><w:pStyle w:val="Heading3CR"/></w:pPr>
      <w:r><w:t>Article 2 – Scope</w:t></w:r>
    </w:p>
    <w:p>
      <w:pPr><w:pStyle w:val="Normal"/></w:pPr>
      <w:r><w:t>This fixture stands in for the scope article of the implementing act.</w:t></w:r>
    </w:p>

    <w:p>
      <w:pPr><w:pStyle w:val="Heading2"/></w:pPr>
      <w:r><w:t>ANNEX I — INFORMATION SECURITY — AUTHORITY REQUIREMENTS [PART-IS.AR]</w:t></w:r>
    </w:p>
    <w:p>
      <w:pPr><w:pStyle w:val="Heading3IR"/></w:pPr>
      <w:r><w:t>IS.AR.200 Information security management system</w:t></w:r>
    </w:p>
    <w:p>
